{
  "name": "the-point",
  "description": "AI summaries of YouTube videos before you watch them",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/core",
    "apps/extension",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev -w @the-point/extension",
    "dev:edge": "npm run dev:edge -w @the-point/extension",
    "build": "npm run build -w @the-point/extension",
    "zip": "npm run zip -w @the-point/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "try": "npm run try -w @the-point/core --",
    "icons": "npm run icons -w @the-point/extension",
    "secrets": "node scripts/check-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
